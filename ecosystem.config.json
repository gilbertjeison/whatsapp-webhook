{
  "apps": [{
    "name": "topped-whatsapp",
    "script": "src/app.js",
    "instances": "max",
    "exec_mode": "cluster",
    "env_production": {
      "NODE_ENV": "production",
      "HOST": "0.0.0.0"
    },
    "env_development": {
      "NODE_ENV": "development",
      "HOST": "localhost"
    },
    "watch": false,
    "max_memory_restart": "1G",
    "error_file": "logs/error.log",
    "out_file": "logs/out.log",
    "merge_logs": true,
    "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
    "autorestart": true
  }]
}